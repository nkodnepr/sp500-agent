# Скопируйте этот файл в .env и заполните своими значениями
TELEGRAM_TOKEN=ваш_токен_от_BotFather

# РЕКОМЕНДУЕТСЯ: ваш числовой Telegram user_id (узнать — написать боту
# @userinfobot), через запятую если пользователей несколько. Если оставить
# пустым, бот отвечает ЛЮБОМУ пользователю Telegram, который его найдёт.
ALLOWED_TELEGRAM_USER_IDS=

DB_PATH=watchlist.db
MODELS_CACHE_DIR=models_cache

DAILY_ANALYSIS_HOUR=9
DAILY_ANALYSIS_MINUTE=30

CONFIDENCE_THRESHOLD=0.6
SIGNAL_THRESHOLD_PCT=0.03
HISTORY_YEARS=5
